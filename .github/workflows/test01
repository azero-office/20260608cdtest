name: Nginx Health Check

on:
  schedule:
    - cron: '*/5 * * * *'
  workflow_dispatch:

jobs:
  check-nginx:
    runs-on: ubuntu-latest

    env:
      TARGET_URL: "http://13.209.50.127"

    steps:
      - name: Check Nginx and Send Teams Alert
        env:
          TEAMS_WEBHOOK: ${{ secrets.TEAMS_WEBHOOK }}
        run: |
          CURRENT_TIME=$(date -u '+%Y-%m-%d %H:%M:%S UTC')

          if curl -fsS --max-time 10 "$TARGET_URL" > /dev/null; then
            MESSAGE="✅ 정상 - Nginx 접속 가능"
          else
            MESSAGE="🚨 장애 - Nginx 접속 실패"
          fi

          curl -X POST "$TEAMS_WEBHOOK" \
            -H "Content-Type: application/json" \
            -d "{
              \"type\": \"AdaptiveCard\",
              \"\$schema\": \"http://adaptivecards.io/schemas/adaptive-card.json\",
              \"version\": \"1.4\",
              \"body\": [
                {
                  \"type\": \"TextBlock\",
                  \"text\": \"GitHub Actions Nginx 점검\",
                  \"weight\": \"Bolder\",
                  \"size\": \"Large\"
                },
                {
                  \"type\": \"TextBlock\",
                  \"text\": \"$MESSAGE\",
                  \"wrap\": true
                },
                {
                  \"type\": \"TextBlock\",
                  \"text\": \"URL: $TARGET_URL\",
                  \"wrap\": true
                },
                {
                  \"type\": \"TextBlock\",
                  \"text\": \"시간: $CURRENT_TIME\",
                  \"wrap\": true
                }
              ]
            }"
